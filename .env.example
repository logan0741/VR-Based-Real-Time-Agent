# Pose3D 브랜치 환경 변수 예시
# ─────────────────────────────────────────────────────────────────────────────
# 쓰는 법: 이 파일을 저장소 루트에 `.env` 로 복사한다 (`.env` 는 gitignore 대상).
#   - model_3d/server_app/server.py 는 시작할 때 루트의 `.env` 를 직접 읽는다
#     (이미 셸에 설정된 값이 있으면 그 값을 우선한다).
#   - pipeline_cli / train_* 스크립트는 `.env` 를 읽지 않는다. 그쪽은 셸에서
#     `$env:KEY="value"` (PowerShell) 또는 `export KEY=value` 로 넘긴다.
# 주석 처리된 값은 코드에 적힌 기본값이다. 바꿀 것만 주석을 풀어 쓰면 된다.
# (예외: DB_ENABLED 는 코드 기본값이 true 지만 여기서는 MySQL 없이도 돌도록 false 로 둔다.)
# ─────────────────────────────────────────────────────────────────────────────

# ── 피팅 백엔드 선택 ─────────────────────────────────────────────────────────
# 서버(server_app/server.py): lifter(기본) | optimization(SMPL-X Adam 피팅, 느림)
# 오프라인 파이프라인(fitter.py build_pose_fitter): optimization(기본) | regression(OSX/PIXIE 자리표시자, 미구현)
#   오프라인에서 lifter 를 쓰려면 FITTER_BACKEND 가 아니라 LIFTER_CHECKPOINT 를 준다 (pipeline.py).
# ★ 같은 이름인데 두 곳의 기본값·허용값이 다르다. 서버만 쓸 거면 비워 둬도 된다.
# FITTER_BACKEND=lifter

# 학습된 PoseLifter 체크포인트 경로 (서버 기본값, 저장소 루트 기준 상대 경로)
# pipeline.py 쪽은 이 값이 있을 때만 lifter 를 쓴다.
# LIFTER_CHECKPOINT=model_3d\artifacts\checkpoints\fitness_pose_lifter_latest_best.pt

# ── SMPL-X 모델 / 최적화 (fitter.py, smplx_coordinate_fitter.py) ──────────────
# SMPL-X 모델 파일. 비우면 smplx_locked_head/neutral/model.npz 등을 자동 탐색한다.
# 모델 파일은 라이선스상 재배포하지 않는다 — docs/00_환경_준비/00_처음_시작.md 참고.
# SMPLX_MODEL_PATH=smplx_locked_head/neutral/model.npz
# .pkl 를 가리켜도 옆의 model.npz 를 우선한다. true 면 .pkl 을 그대로 쓴다 (chumpy 필요할 수 있음).
# SMPLX_ALLOW_PKL=false
# COCO 17 관절 회귀 행렬(.npy). 없으면 내장 관절 매핑을 쓴다.
# COCO_J_REGRESSOR_PATH=
# 2D 리프로젝션 최적화 반복 수 / 학습률 / 포즈 prior 가중치
# SMPLX_OPT_ITERS=15
# SMPLX_OPT_LR=0.03
# SMPLX_POSE_PRIOR_WEIGHT=0.001
# 초기 카메라 깊이 (SMPL-X 좌표 단위)
# SMPLX_CAMERA_DEPTH=2.5
# 프레임별 최적화 loss 기록 (QA 그래프용)
# SMPLX_CAPTURE_LOSS_HISTORY=true
# 응답에 메시 정점까지 담을지 (크다)
# RETURN_VERTICES=false
# GPU 사용 여부 (CUDA 가 없으면 자동으로 CPU)
# USE_CUDA=true
# 3D 좌표 → SMPL-X 피팅(smplx_coordinate_fitter.py) 전용
# SMPLX_3D_OPT_ITERS=        (비우면 클래스 기본값)
# SMPLX_3D_OPT_LR=           (비우면 클래스 기본값)
# SMPLX_3D_JOINT_LOSS_WEIGHT=1.0
# SMPLX_3D_REPROJ_LOSS_WEIGHT=0.01

# ── 가상 카메라 (fitter.py, 2D 리프로젝션용 핀홀 카메라) ─────────────────────
# CAMERA_WIDTH=640
# CAMERA_HEIGHT=480
# CAMERA_FX=500
# CAMERA_FY=500
# CAMERA_CX=320
# CAMERA_CY=240
# CAMERA_FLIP_Y=true

# ── 입력 키포인트 형식 (preprocessing.py) ────────────────────────────────────
# movenet_yx: MoveNet 정규화 [y, x, score] (기본) | xy: [x, y, score]
# KEYPOINT_FORMAT=movenet_yx

# ── QA 진단 이미지 (diagnostics.py) ──────────────────────────────────────────
# 프레임마다 PNG 를 쓰므로 실시간 측정 때는 false 또는 SAVE_EVERY_N 을 키운다.
# DIAGNOSTICS_ENABLED=true
# DIAGNOSTICS_OUTPUT_DIR=     (비우면 model_3d/artifacts/pose_debug)
# DIAGNOSTICS_SAVE_EVERY_N=1
# DIAGNOSTICS_GRAPH_EVERY_N=1
# DIAGNOSTICS_GRAPH_WINDOW=200

# ── 시간축 스무딩 (pose_retargeting.py PoseRetargeter) ───────────────────────
# OneEuro 필터 + 속도 제한. global_orient 의 속도 제한은 MAX_VELOCITY 의 절반(0.25)이다.
# SMOOTHING_ENABLED=true
# SMOOTHING_MIN_CUTOFF=1.0
# SMOOTHING_BETA=0.007
# SMOOTHING_D_CUTOFF=1.0
# SMOOTHING_MAX_VELOCITY=0.5

# ── 운동 세션 저장 (server_app/database.py, MySQL) ───────────────────────────
# MySQL 이 없으면 DB_ENABLED=false 로 둔다. true 인데 연결이 안 되면 `[DB] Disabled: ...` 를 찍고
# 저장만 건너뛴다 (database.py ExerciseSessionRepository.__init__).
DB_ENABLED=false
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=vr_fitness
DB_CHARSET=utf8mb4

# ── 문서에만 남은 키 (이 브랜치 코드는 읽지 않는다) ──────────────────────────
# ENABLE_NGROK, NGROK_AUTHTOKEN, POSE_QUEUE_MAXSIZE 는 model_3d/README.md 와
# docs/40_분석_기록/ 에 나오지만, 그 설정을 읽던 예전 루트 server.py 는 이 스냅샷에 없다.
# model_3d/server_app/server.py 는 ngrok 을 띄우지 않는다 (run_steps.py --cloudflare 는 cloudflared 사용).
