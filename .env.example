# ── App 브랜치 환경 변수 예시 ────────────────────────────────────────────
# 이 파일을 저장소 루트에 `.env` 로 복사해서 쓴다.  (cp .env.example .env)
# `.env` 는 .gitignore 에 들어 있어 커밋되지 않는다.
#
# 읽는 방식 (final/s02_backend/server.py `load_env_file`):
#   - 서버가 시작될 때(lifespan) 루트의 `.env` 를 한 줄씩 읽는다.
#   - 셸에 이미 같은 이름의 환경 변수가 있으면 셸 값이 이긴다.
#   - `KEY=` 처럼 값이 빈 줄도 "빈 문자열" 로 들어간다. 숫자 키를 빈 값으로 두면
#     int("") 에서 서버가 죽으므로, 쓰지 않을 키는 아예 주석으로 둔다.
#   - 예외: CAMERA_MIN_CONFIDENCE / CAMERA_EDGE_MARGIN 은 모듈 import 시점에 읽혀서
#     `.env` 보다 먼저 결정된다. 이 둘은 셸에서 설정해야 적용된다
#     (PowerShell: $env:CAMERA_MIN_CONFIDENCE="0.2").

# ── MySQL (선택) ─────────────────────────────────────────────────────────
# 끝난 운동 세션 요약을 exercise_sessions 테이블에 저장한다 (final/s03_database/database.py).
# MySQL 이 없으면 false 로 둔다. 코드 기본값은 true 이지만, 연결에 실패해도 서버는
# "[DB] Disabled: ..." 를 찍고 계속 돈다.
DB_ENABLED=false
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=vr_fitness
DB_CHARSET=utf8mb4

# ── 카메라 가시성 게이트 (셸에서 설정해야 적용됨, 위 설명 참고) ──────────
# 운동별 keypoints_used 관절 중 하나라도 confidence 가 이 값보다 낮거나
# 화면 가장자리 margin 안쪽에 있으면 그 프레임은 countable=false (점수·횟수 제외).
# CAMERA_MIN_CONFIDENCE=0.12
# CAMERA_EDGE_MARGIN=0.01

# ── 실시간 판정 튜닝 (주석을 풀면 적용, 적힌 값이 기본값) ─────────────────
# 주의: 값 뒤에 같은 줄 주석을 달지 않는다. load_env_file 은 인라인 주석을 지우지 않는다.
#
# false 면 전처리 세션을 만들지 않는다 (relay 만 동작)
# PREPROCESSING_ENABLED=true
# false 면 실시간 창 DTW 를 끄고 rep 이 끝났을 때만 DTW 를 돈다
# PREPROCESSING_REALTIME_DTW=true
# 피드백 엔진을 몇 프레임마다 돌릴지
# FEEDBACK_INTERVAL_FRAMES=8
# 피드백 1개를 유지할 프레임 수. 기본값은 운동 target_fps*3 (squat 24fps -> 72, 약 3초)
# FEEDBACK_HOLD_FRAMES=72
# 전문가 시퀀스를 몇 프레임 간격으로 DTW 에 쓸지
# DTW_EXPERT_STRIDE=1
# 운동 설정(final/s01_preprocessing/config.py) 값 덮어쓰기: dtw_interval / n_frames / max_distance
# DTW_INTERVAL_OVERRIDE=3
# DTW_N_FRAMES_OVERRIDE=30
# SCORE_MAX_DISTANCE_OVERRIDE=1.0

# ── 3D 리프터 잔재 (App 브랜치에서는 기본값 그대로 둔다) ─────────────────
# server.py 는 이전 3D 경로의 PoseLifterNet 을 여전히 만든다. REALTIME_2D_ONLY=true 이면
# 실시간 경로는 2D 만 쓰므로 체크포인트가 없어도 된다
# ("[Lifter] No checkpoint found. Running with initialized weights." 가 정상).
# FITTER_BACKEND=optimization 은 model_3d 패키지가 필요한데 이 브랜치에는 없다 (Pose3D 브랜치 참고).
# REALTIME_2D_ONLY=true
# FITTER_BACKEND=lifter
# LIFTER_CHECKPOINT=model_3d/artifacts/checkpoints/fitness_pose_lifter_latest_best.pt
# SMOOTHING_ENABLED=true
# SMOOTHING_MIN_CUTOFF=1.0
# SMOOTHING_BETA=0.007
# SMOOTHING_D_CUTOFF=1.0
# SMOOTHING_MAX_VELOCITY=0.5

# ── 이전 작업 공간에서 넘어온 키 (final/ 코드는 읽지 않는다) ─────────────
# 서버 주소·포트는 final/scripts/*.ps1 의 인자(-HostName, -Port)로 정한다.
# APP_ENV=local
# DEBUG=false
# API_HOST=127.0.0.1
# API_PORT=8000
# API_RELOAD=true
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
# DATA_DIR=./data
# RAW_DATA_DIR=./data/raw
# PROCESSED_DATA_DIR=./data/processed
# ARTIFACT_DIR=./artifacts
# LOG_DIR=./logs
# ALLOW_EXTERNAL_UPLOAD=false
# ALLOW_CLOUD_SYNC=false
# SAVE_CAPTURED_MEDIA_LOCAL_ONLY=true
# EXPORT_DEBUG_VIDEO=false
