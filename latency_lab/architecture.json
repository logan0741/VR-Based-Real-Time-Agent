{
  "name": "latency_lab",
  "purpose": "Measure and reproduce app/viewer/backend latency instrumentation.",
  "runnable_entrypoints": [
    {
      "path": "measure_latency.py",
      "description": "Single WebSocket latency probe using synthetic COCO-17 keypoints."
    },
    {
      "path": "run_latency_suite.py",
      "description": "Runs local and Cloudflare latency probes and writes comparison reports."
    }
  ],
  "implementation_stages": [
    {
      "stage": "00_shared",
      "path": "implementation/00_shared/latencyTelemetry.ts",
      "target": "shared frontend telemetry helper"
    },
    {
      "stage": "01_viewer",
      "path": "implementation/01_viewer/viewerLatency.js",
      "target": "viewer keypoint send instrumentation"
    },
    {
      "stage": "02_backend",
      "path": "implementation/02_backend/latency_debug_fields.py",
      "target": "server-side timestamp fields for /ws/pose"
    },
    {
      "stage": "03_app",
      "path": "implementation/03_app/useLatencyMetrics.ts",
      "target": "React app receive-side metrics"
    },
    {
      "stage": "04_report",
      "path": "implementation/04_report/latencyReportWriter.ts",
      "target": "browser-side JSON report download"
    }
  ],
  "current_project_touchpoints": [
    "final/s02_backend/server.py",
    "viewer_2d/viewer.js",
    "src/hooks/useWebSocket.ts",
    "src/hooks/useCamera.ts"
  ],
  "generated_reports": [
    "results/latency_report_local.json",
    "results/latency_report_cloudflare.json",
    "results/latency_suite_summary.json"
  ]
}
